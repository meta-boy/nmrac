#!/usr/bin/env bash
# nmrac - Netmaker Remote Access Client, CLI edition. Linux and macOS.
#
# Does what Netmaker Desktop does, headless. Targets Netmaker server v1.5.1.
#
# Endpoints used, and why these and not others:
#   ws  /api/oauth/headless                        SSO login (32-char state ->
#                                                  HandleHeadlessSSOCallback, no
#                                                  admin check; the 64-char host
#                                                  state IS admin-gated)
#   GET /api/users/{user}/remote_access_gw         networks + gateways. Wrapped in
#                                                  ContinueIfUserMatch, so it needs
#                                                  no TARGET_RSRC header.
#   GET    /api/extclients/{net}/{clientid}        does this box have a client?
#   POST   /api/extclients/{net}/{gwid}            create one
#   GET    /api/extclients/{net}/{clientid}/file   canonical wg-quick config
#   DELETE /api/extclients/{net}/{clientid}        remove it
#
# The /api/v1/rac/* family is NOT usable behind a reverse proxy: its authz
# requires a TARGET_RSRC request header, and underscored headers are dropped by
# common proxy defaults, so every call returns 403 "target rsrc is missing".
# /api/v1/device/* does not exist until a later server release (404 on v1.5.1).

set -euo pipefail

# die() is often reached inside a $(command substitution), where a plain exit
# would only end the subshell and let the caller carry on with empty output.
# Signal the top-level shell so a failure actually stops the run.
TOP_PID=$$
trap 'exit 1' TERM

die() { printf 'error: %s\n' "$*" >&2; kill -TERM "$TOP_PID" 2>/dev/null || true; exit 1; }
note() { printf '%s\n' "$*" >&2; }

OS_NAME="$(uname -s)"

STATE_DIR="${NMRAC_STATE_DIR:-/etc/nmrac}"
SERVER_FILE="$STATE_DIR/server"
# Which Netmaker server to talk to: $NMRAC_API, else the URL saved by
# `nmrac server <url>`. Deliberately not hardcoded.
API="${NMRAC_API:-}"
if [ -z "$API" ] && [ -r "$SERVER_FILE" ]; then
  API="$(tr -d '[:space:]' < "$SERVER_FILE")"
fi
API="${API%/}"
TOKEN_FILE="${NMRAC_TOKEN_FILE:-$STATE_DIR/token}"
IFMAP="$STATE_DIR/ifaces"
WG_DIR="${NMRAC_WG_DIR:-/etc/wireguard}"

# ------------------------------------------------------------ portability

mktemp_file() { mktemp "${TMPDIR:-/tmp}/nmrac.XXXXXXXX"; }

sha1_hex() {
  if command -v sha1sum >/dev/null 2>&1; then sha1sum | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 1 | cut -d' ' -f1
  else openssl dgst -sha1 | awk '{print $NF}'
  fi
}

# GNU coreutils decodes with -d, BSD/macOS with -D.
b64_decode() { base64 -d 2>/dev/null || base64 -D 2>/dev/null; }

# The machine half of a client id. Netmaker validates ids in
# controllers/regex.go:validName - ^[a-zA-Z0-9-]+$, 5 to 32 characters - so dots
# and underscores are rejected, not just cosmetic. macOS `hostname` can return
# junk such as "Unknown_1a:57:a6:73:75:06" when no name is set and DNS names
# carry dots, so fold every separator to a dash rather than keeping characters
# the server refuses with "node name must be alphanumderic and/or dashes".
default_client_base() {
  local h=""
  if [ "$OS_NAME" = "Darwin" ]; then
    h="$(scutil --get LocalHostName 2>/dev/null || true)"
    [ -n "$h" ] || h="$(scutil --get ComputerName 2>/dev/null || true)"
  fi
  [ -n "$h" ] || h="$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)"
  h="$(printf '%s' "$h" | tr '[:upper:]' '[:lower:]' | tr '._ ' '---' \
       | tr -cd '[:alnum:]-' | tr -s '-')"
  h="${h#-}"; h="${h%-}"
  [ -n "$h" ] || h="host-$(printf '%s' "$(uname -a)" | sha1_hex | cut -c1-8)"
  printf '%s' "$h"
}

CLIENT_BASE="$(default_client_base)"

# Machine-level id. Two things still want one that is not tied to a network:
# the gateway listing, where it is only the caller's identity, and the clients
# this tool created before ids were network-scoped - see resolve_client().
CLIENT_ID="${NMRAC_CLIENT_ID:-$CLIENT_BASE-cli}"

validate_client_id() {
  case "$1" in
    ""|*[!a-zA-Z0-9-]*)
      die "invalid client id '$1': Netmaker allows letters, digits and dashes only" ;;
  esac
  [ "${#1}" -ge 5 ] && [ "${#1}" -le 32 ] \
    || die "invalid client id '$1': must be 5 to 32 characters"
}

# The id this machine uses on one network. Netmaker requires ext-client ids to
# be unique across the WHOLE server, not within a network: isValid() in
# controllers/ext_client.go checks a new id against logic.GetAllExtClients().
# So a single id per machine only ever works on one network - connecting to a
# second one fails with HTTP 400 "client validation: duplicate client name".
# Hence one id per network, with the network folded into a short hash because
# validName caps the whole id at 32 characters.
client_id_for() {
  local net="$1" base id
  if [ -n "${NMRAC_CLIENT_ID:-}" ]; then
    id="$NMRAC_CLIENT_ID"
  else
    base="$(printf '%s' "$CLIENT_BASE" | cut -c1-25)"; base="${base%-}"
    id="$base-$(printf '%s' "$net" | sha1_hex | cut -c1-6)"
  fi
  validate_client_id "$id"
  printf '%s' "$id"
}

# wg-quick on macOS cannot name the interface, so it creates a utunN device and
# records the real name in /var/run/wireguard/<name>.name.
real_iface() {
  local iface="$1" f="/var/run/wireguard/$1.name"
  if [ "$OS_NAME" = "Darwin" ] && [ -r "$f" ]; then
    tr -d '[:space:]' < "$f"
  else
    printf '%s' "$iface"
  fi
}

# `wg show interfaces` lists live WireGuard devices on both platforms.
iface_up() {
  local dev; dev="$(real_iface "$1")"
  [ -n "$dev" ] || return 1
  wg show interfaces 2>/dev/null | tr ' ' '\n' | grep -qx "$dev"
}

iface_addr() {
  local dev; dev="$(real_iface "$1")"
  [ -n "$dev" ] || return 0
  if [ "$OS_NAME" = "Darwin" ]; then
    ifconfig "$dev" 2>/dev/null | awk '/inet /{print $2; exit}'
  else
    ip -4 -o addr show "$dev" 2>/dev/null | awk '{print $4; exit}'
  fi
}

# Can this machine apply a `DNS =` line? macOS wg-quick does it natively via
# scutil; Linux wg-quick shells out to resolvconf, which is often absent.
dns_supported() {
  [ "$OS_NAME" = "Darwin" ] && return 0
  command -v resolvconf >/dev/null 2>&1
}

host_os_fields() {
  if [ "$OS_NAME" = "Darwin" ]; then
    jq -nc --arg v "$(sw_vers -productVersion 2>/dev/null || true)" \
           --arg k "$(uname -r)" \
      '{os:"darwin", os_family:"darwin", os_version:$v, kernel_version:$k}'
  else
    local ver=""
    [ -r /etc/os-release ] && ver="$( . /etc/os-release 2>/dev/null || true; printf '%s' "${VERSION_ID:-}" )"
    jq -nc --arg v "$ver" --arg k "$(uname -r)" \
      '{os:"linux", os_family:"linux", os_version:$v, kernel_version:$k}'
  fi
}

# ------------------------------------------------------------ basics

need_root() { [ "$(id -u)" -eq 0 ] || die "must run as root (needs $WG_DIR and wg-quick)"; }
need_api() { [ -n "$API" ] || die "no server set - run: $0 server https://netmaker.example.com"; }
need_cmd() {
  local missing=""
  for c in "$@"; do command -v "$c" >/dev/null 2>&1 || missing="$missing $c"; done
  [ -z "$missing" ] || die "missing required command(s):$missing"
}

cmd_server() {
  local url="${1:-}"
  if [ -z "$url" ]; then
    [ -n "$API" ] || die "no server set"
    printf '%s\n' "$API"; return 0
  fi
  case "$url" in
    https://*|http://*) ;;
    *) die "server must be an http(s) URL: $url" ;;
  esac
  need_root
  mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"
  printf '%s\n' "${url%/}" > "$SERVER_FILE"; chmod 644 "$SERVER_FILE"
  note "server set to ${url%/}"
}

token() {
  [ -r "$TOKEN_FILE" ] || die "not logged in - run: $0 login"
  tr -d '[:space:]' < "$TOKEN_FILE"
}

username() {
  local payload
  payload="$(token | cut -d. -f2 | tr '_-' '/+')"
  case $(( ${#payload} % 4 )) in
    2) payload="$payload==" ;;
    3) payload="$payload=" ;;
  esac
  printf '%s' "$payload" | b64_decode | jq -r '.username // .UserName // empty'
}

# ------------------------------------------------------------ http

# Echoes the status code on line 1, then the body. Never dies, so callers can
# branch on the code.
http_raw() {
  need_api
  local method="$1" path="$2" body="${3:-}"
  local -a args=(-sS -X "$method" -H "Authorization: Bearer $(token)")
  [ -n "$body" ] && args+=(-H 'Content-Type: application/json' -d "$body")
  local out
  if ! out="$(curl "${args[@]}" -w $'\n%{http_code}' "$API$path" 2>/dev/null)"; then
    printf '000\n'; return 0
  fi
  printf '%s\n' "$(printf '%s' "$out" | tail -n1)"
  printf '%s' "$out" | sed '$d'
}

http_code() { http_raw "$@" | head -n1; }

# Returns the body on 2xx, dies with the server's message otherwise.
api() {
  local r code body
  r="$(http_raw "$@")"
  code="$(printf '%s' "$r" | head -n1)"
  body="$(printf '%s' "$r" | tail -n +2)"
  case "$code" in
    2*) printf '%s' "$body" ;;
    000) die "could not reach $API" ;;
    401) die "unauthorized - token expired, re-run: $0 login" ;;
    *)
      local msg; msg="$(printf '%s' "$body" | jq -r '.Message // empty' 2>/dev/null || true)"
      die "HTTP $code from $2: ${msg:-$body}"
      ;;
  esac
}

# ------------------------------------------------------------ login

ws_login() {
  NMRAC_WS="${API/#https:/wss:}/api/oauth/headless" node -e '
const ws = new WebSocket(process.env.NMRAC_WS);
let gotUrl = false;
const timer = setTimeout(() => { console.error("timed out waiting for SSO (5 min)"); process.exit(1); }, 300000);
ws.onmessage = (ev) => {
  const msg = String(ev.data).trim();
  if (msg.startsWith("JWT: ")) {
    clearTimeout(timer);
    process.stdout.write(msg.slice(5).trim());
    ws.close(); process.exit(0);
  }
  if (!gotUrl) { gotUrl = true; console.error("\nOpen this and sign in:\n\n  " + msg + "\n\nWaiting..."); }
  else console.error("server: " + msg);
};
ws.onerror = (e) => { clearTimeout(timer); console.error("websocket error: " + (e?.message || "connect failed")); process.exit(1); };
ws.onclose = () => { clearTimeout(timer); if (gotUrl) console.error("server closed before sending a token"); process.exit(1); };
'
}

cmd_login() {
  need_root; need_api; need_cmd curl jq
  local jwt
  if [ "${1:-}" = "--paste" ]; then
    note "Sign in at $API/api/oauth/login, then copy the 'login' parameter"
    note "from the dashboard URL you land on."
    printf '\nPaste JWT (or the whole URL): ' >&2
    read -r jwt
    jwt="$(printf '%s' "$jwt" | tr -d '[:space:]')"
    case "$jwt" in *login=*) jwt="${jwt#*login=}"; jwt="${jwt%%&*}" ;; esac
  else
    command -v node >/dev/null 2>&1 || die "needs node >=22 for WebSocket, or use: $0 login --paste"
    jwt="$(ws_login)" || die "SSO login failed"
  fi
  [ -n "$jwt" ] || die "no token received"

  mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"
  printf '%s\n' "$jwt" > "$TOKEN_FILE"; chmod 600 "$TOKEN_FILE"
  note ""
  note "authenticated as $(username) - token saved to $TOKEN_FILE"
}

cmd_logout() {
  need_root
  rm -f "$TOKEN_FILE"
  note "token removed (tunnels left alone; use '$0 disconnect' to drop them)"
}

# ------------------------------------------------------------ gateways

# network -> gateway. Note: this endpoint returns a RAW map, not the
# {Code,Message,Response} envelope the /api/v1/* endpoints use.
gateways_json() {
  api GET "/api/users/$(username)/remote_access_gw" \
    "$(jq -nc --arg c "$CLIENT_ID" '{remote_access_clientid:$c}')"
}

gw_for_network() {
  gateways_json | jq -r --arg n "$1" '.[$n][0].remote_access_gw_id // empty'
}

# Interface names are capped at 15 chars on Linux, and Netmaker network names
# are often longer, so derive a short one and remember the mapping for display.
iface_for() {
  local net="$1" san cand
  san="$(printf '%s' "$net" | tr -cd '[:alnum:]-')"
  cand="nm-$(printf '%s' "$san" | cut -c1-12)"
  if [ -r "$IFMAP" ]; then
    local owner; owner="$(awk -v i="$cand" '$1==i{print $2}' "$IFMAP" | head -1)"
    if [ -n "$owner" ] && [ "$owner" != "$net" ]; then
      cand="nm-$(printf '%s' "$net" | sha1_hex | cut -c1-8)"   # collision
    fi
  fi
  printf '%s' "$cand"
}

remember_iface() {
  local iface="$1" net="$2"
  mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"
  touch "$IFMAP"; chmod 600 "$IFMAP"
  grep -v -e "^$iface " "$IFMAP" > "$IFMAP.tmp" 2>/dev/null || true
  printf '%s %s\n' "$iface" "$net" >> "$IFMAP.tmp"
  mv "$IFMAP.tmp" "$IFMAP"
}

net_for_iface() { [ -r "$IFMAP" ] && awk -v i="$1" '$1==i{print $2}' "$IFMAP" | head -1; }

# ------------------------------------------------------------ config

client_body() {
  local id="$1"
  jq -nc \
    --arg id "$id" --arg dn "$(hostname 2>/dev/null || printf '%s' "$id")" \
    --argjson osf "$(host_os_fields)" \
    '{clientid:$id, enabled:true, device_id:$id, device_name:$dn,
      client_version:"nmrac-cli"} + $osf'
}

# Which id this machine goes by on a network, and whether it is already there.
# Globals because bash 3.2 (stock macOS) cannot return a pair and both callers
# need one.
RESOLVED_ID=""
RESOLVED_EXISTS=false

resolve_client() {
  local net="$1" legacy
  RESOLVED_ID="$(client_id_for "$net")"
  RESOLVED_EXISTS=false
  # A client that does not exist answers 403 "access denied" on this server,
  # not 404 - so treat anything non-200 as "not present" and let the create
  # call be what reports a genuine permission problem.
  if [ "$(http_code GET "/api/extclients/$net/$RESOLVED_ID")" = "200" ]; then
    RESOLVED_EXISTS=true
    return 0
  fi
  # Before ids were network-scoped this tool created "<machine>-cli". Keep using
  # one that is still on the network rather than creating a second client beside
  # it, which would strand the old one and the address it holds.
  legacy="$CLIENT_ID"
  if [ "$legacy" != "$RESOLVED_ID" ] &&
     [ "$(http_code GET "/api/extclients/$net/$legacy")" = "200" ]; then
    RESOLVED_ID="$legacy"
    RESOLVED_EXISTS=true
  fi
  return 0
}

# Ensure this machine has its own ext-client on the given network, then return
# the server-rendered wg-quick config.
fetch_conf() {
  local net="$1" gw="$2"
  resolve_client "$net"
  if [ "$RESOLVED_EXISTS" != true ]; then
    note "creating remote-access client '$RESOLVED_ID' on $net"
    api POST "/api/extclients/$net/$gw" "$(client_body "$RESOLVED_ID")" >/dev/null
  fi
  api GET "/api/extclients/$net/$RESOLVED_ID/file"
}

# ------------------------------------------------------------ commands

cmd_connect() {
  need_root; need_cmd curl jq wg wg-quick
  local dns_mode=auto net=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dns) dns_mode=on ;;
      --no-dns) dns_mode=off ;;
      -*) die "unknown flag: $1" ;;
      *) net="$1" ;;
    esac
    shift
  done
  if [ -z "$net" ]; then
    net="$(pick_network)" || exit 1
    [ -n "$net" ] || { note "cancelled"; exit 0; }
  fi

  local gw; gw="$(gw_for_network "$net")"
  [ -n "$gw" ] || die "no gateway for '$net' - check '$0 list'"

  local iface conf; iface="$(iface_for "$net")"
  conf="$(fetch_conf "$net" "$gw")"

  # The server always emits a DNS line. Keep it only where wg-quick can apply
  # it, otherwise the tunnel fails to come up at all.
  case "$dns_mode" in
    on)  dns_supported || die "--dns needs resolvconf (apt install openresolv)" ;;
    off) conf="$(printf '%s\n' "$conf" | grep -v '^[[:space:]]*DNS[[:space:]]*=')" ;;
    auto)
      if ! dns_supported; then
        conf="$(printf '%s\n' "$conf" | grep -v '^[[:space:]]*DNS[[:space:]]*=')"
      fi
      ;;
  esac

  mkdir -p "$WG_DIR"; chmod 700 "$WG_DIR"
  local target="$WG_DIR/$iface.conf" tmp
  tmp="$(mktemp_file)"; chmod 600 "$tmp"
  printf '%s\n' "$conf" > "$tmp"
  grep -q '^PrivateKey = .\+' "$tmp" || { rm -f "$tmp"; die "server returned a config with no private key"; }
  mv "$tmp" "$target"; chmod 600 "$target"
  remember_iface "$iface" "$net"

  wg-quick down "$iface" >/dev/null 2>&1 || true
  wg-quick up "$iface"
  note ""
  cmd_status
}

cmd_disconnect() {
  need_root; need_cmd wg wg-quick
  local net="${1:-}"
  if [ -n "$net" ]; then
    local iface; iface="$(iface_for "$net")"
    wg-quick down "$iface" || die "not up: $net ($iface)"
    return 0
  fi
  local any=false f iface
  for f in "$WG_DIR"/nm-*.conf; do
    [ -e "$f" ] || continue
    iface="$(basename "$f" .conf)"
    if iface_up "$iface"; then
      wg-quick down "$iface" && any=true
    fi
  done
  [ "$any" = true ] || note "(nothing to disconnect)"
}

# One TSV row per network: net, gwname, state, addr. Shared by list and the
# interactive picker so both always agree.
net_rows() {
  printf '%s' "$1" \
    | jq -r 'to_entries[] | [.key, (.value[0].gw_name // "-")] | @tsv' \
    | sort | while IFS="$(printf '\t')" read -r net gwname; do
        local iface state addr
        iface="$(iface_for "$net")"
        if iface_up "$iface"; then
          state="on"; addr="$(iface_addr "$iface")"
        else
          state="off"; addr=""
        fi
        printf '%s\t%s\t%s\t%s\n' "$net" "$gwname" "$state" "$addr"
      done
}

cmd_list() {
  need_cmd curl jq
  local gws rows tab; tab="$(printf '\t')"
  gws="$(gateways_json)"
  rows="$(net_rows "$gws")"
  printf 'Networks %s   (user: %s)\n\n' "$(printf '%s\n' "$rows" | grep -c . || true)" "$(username)"
  while IFS="$tab" read -r net gwname state addr; do
    [ -n "$net" ] || continue
    printf '  [%-3s]  %-28s gw %-16s %s\n' "$state" "$net" "$gwname" "$addr"
  done <<EOF
$rows
EOF
  printf '\n  connect:    %s connect [network]\n' "$0"
  printf '  disconnect: %s disconnect [network]\n' "$0"
}

# Prompt for a network. Menu goes to stderr, the chosen name to stdout, so this
# is safe in a command substitution. Prints nothing if cancelled.
pick_network() {
  local gws rows tab; tab="$(printf '\t')"
  gws="$(gateways_json)"; rows="$(net_rows "$gws")"
  local nets="" i=0

  printf '\nNetworks (user: %s)\n\n' "$(username)" >&2
  while IFS="$tab" read -r net gwname state addr; do
    [ -n "$net" ] || continue
    i=$((i + 1))
    nets="$nets$net
"
    printf '  %d) [%-3s]  %-28s gw %-16s %s\n' "$i" "$state" "$net" "$gwname" "$addr" >&2
  done <<EOF
$rows
EOF
  [ "$i" -gt 0 ] || die "no networks available to you"

  printf '\nSelect network [1-%d], or q to quit: ' "$i" >&2
  # Read from the terminal when there is one; fall back to stdin so the menu
  # also works piped. Opening /dev/tty fails outright with no controlling
  # terminal, which -r does not catch.
  local choice=""
  if [ -t 0 ]; then
    read -r choice || true
  elif { exec 3< /dev/tty; } 2>/dev/null; then
    read -r choice <&3 || true
    exec 3<&-
  else
    read -r choice || true
  fi

  case "$choice" in
    q|Q|"") return 0 ;;
    *[!0-9]*) die "not a number: $choice" ;;
  esac
  [ "$choice" -ge 1 ] && [ "$choice" -le "$i" ] || die "out of range: $choice"
  printf '%s\n' "$nets" | sed -n "${choice}p"
}

cmd_status() {
  need_root; need_cmd wg
  local any=false f iface net dev
  for f in "$WG_DIR"/nm-*.conf; do
    [ -e "$f" ] || continue
    iface="$(basename "$f" .conf)"; net="$(net_for_iface "$iface")"
    if iface_up "$iface"; then
      any=true; dev="$(real_iface "$iface")"
      if [ "$dev" != "$iface" ]; then
        printf '%s (%s -> %s): up\n' "${net:-$iface}" "$iface" "$dev"
      else
        printf '%s (%s): up\n' "${net:-$iface}" "$iface"
      fi
      wg show "$dev" | sed 's/^/  /'
    fi
  done
  [ "$any" = true ] || note "(no tunnel is up)"
}

cmd_conf() {
  need_cmd curl jq
  local net="${1:-}"; [ -n "$net" ] || die "usage: $0 conf <network>"
  local gw; gw="$(gw_for_network "$net")"
  [ -n "$gw" ] || die "no gateway for '$net'"
  fetch_conf "$net" "$gw"
}

cmd_remove() {
  need_root; need_cmd curl jq
  local net="${1:-}"; [ -n "$net" ] || die "usage: $0 remove <network>"
  cmd_disconnect "$net" >/dev/null 2>&1 || true
  resolve_client "$net"
  api DELETE "/api/extclients/$net/$RESOLVED_ID" >/dev/null
  rm -f "$WG_DIR/$(iface_for "$net").conf"
  note "removed client '$RESOLVED_ID' from $net"
}

usage() {
  local idline
  if [ -n "${NMRAC_CLIENT_ID:-}" ]; then
    idline="$NMRAC_CLIENT_ID (NMRAC_CLIENT_ID, used on every network)"
  else
    idline="$CLIENT_BASE-<network hash> (one per network)"
  fi
  cat <<EOF
nmrac - Netmaker Remote Access Client (CLI)

  $0 server <url>                        point at a Netmaker server (once)
  $0 login [--paste]                     SSO login (browser), or paste a JWT
  $0 logout                              forget the token
  $0 list                                networks, gateways, on/off state
  $0 connect [--dns|--no-dns] [network]  bring a tunnel up (prompts if omitted)
  $0 disconnect [network]                take it down (all if omitted)
  $0 status                              wg peer state
  $0 conf <network>                      print the config the server hands out
  $0 remove <network>                    delete this machine's client

Platform:  $OS_NAME
Server:    ${API:-<unset - run: $0 server https://netmaker.example.com>}
Client id: $idline
EOF
}

case "${1:-}" in
  server) shift; cmd_server "$@" ;;
  login) shift; cmd_login "$@" ;;
  logout) shift; cmd_logout "$@" ;;
  list|networks) shift; cmd_list "$@" ;;
  connect|up) shift; cmd_connect "$@" ;;
  disconnect|down) shift; cmd_disconnect "$@" ;;
  status) shift; cmd_status "$@" ;;
  conf|config) shift; cmd_conf "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
